 from threedgrut.model.model import MixtureOfGaussians
 
 
+@torch.no_grad()
+def indexed_append(source: torch.Tensor, indices: torch.Tensor, tail: torch.Tensor):
+    """Copy retained rows and appended rows without a full gathered intermediate.
+
+    Exact indexing/copy semantics of cat([source[indices], tail]); avoids an
+    additional ~1.3 GiB SH tensor at eight million float32 Gaussians.
+    """
+    count = indices.numel()
+    result = source.new_empty((count + tail.shape[0], *source.shape[1:]))
+    torch.index_select(source, 0, indices, out=result[:count])
+    result[count:].copy_(tail)
+    return result
+
