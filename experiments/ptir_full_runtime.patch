         torch.cuda.empty_cache()
 
+    def _limit_growth(self, mask, position_grad, normal_grad, growth_per_parent=1):
+        cap = self.conf.strategy.densify.get('max_gaussians', None)
+        if cap is None:
+            return mask
+        available = max(0, int(cap) - self.model.num_gaussians)
+        available = min(available, int(self.conf.strategy.densify.get('max_growth_per_update', available)))
+        budget = available // growth_per_parent
+        indices = torch.nonzero(mask, as_tuple=True)[0]
+        if indices.numel() <= budget:
+            return mask
+        priority = position_grad[indices] / max(self.clone_grad_threshold, 1e-12)
+        priority += normal_grad[indices] / max(self.clone_shading_normal_grad_threshold, 1e-12)
+        keep = indices[torch.topk(priority, budget).indices] if budget else indices[:0]
+        limited = torch.zeros_like(mask); limited[keep] = True
+        logger.info(f'Densification memory budget: selected {budget} / {indices.numel()} candidates; cap={cap}')
+        return limited
+
